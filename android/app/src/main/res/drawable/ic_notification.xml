<?xml version="1.0" encoding="utf-8"?>
<!--
  Status-bar icon for push notifications.

  Android renders the small icon as a silhouette: only the alpha channel
  survives, and the system tints it. So this must be a solid white glyph on a
  transparent background — handing it a full-colour, fully-opaque asset (the
  launcher icon, for instance) is what produces the notorious white square.

  PLACEHOLDER: a generic bell, not the Tweakd mark. The repo has no monochrome
  brand asset to derive one from — the launcher icon is opaque RGB with no
  alpha, and the logo files are a wordmark that turns to mush at 24dp. Replace
  with a proper single-colour Tweakd glyph before release; nothing else needs
  to change, the name stays `ic_notification`.
-->
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    android:width="24dp"
    android:height="24dp"
    android:viewportWidth="24"
    android:viewportHeight="24">
    <path
        android:fillColor="#FFFFFFFF"
        android:pathData="M12,22c1.1,0 2,-0.9 2,-2h-4c0,1.1 0.89,2 2,2zM18,16v-5c0,-3.07 -1.64,-5.64 -4.5,-6.32V4c0,-0.83 -0.67,-1.5 -1.5,-1.5s-1.5,0.67 -1.5,1.5v0.68C7.63,5.36 6,7.92 6,11v5l-2,2v1h16v-1l-2,-2z"/>
