<manifest xmlns:android="http://schemas.android.com/apk/res/android">
    <!-- Runtime push notification permission, required on Android 13 (API 33)+. -->
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS"/>
    <!-- Centres the map's nearby-business query on the user. Foreground only —
         the map has no background tracking, so no ACCESS_BACKGROUND_LOCATION. -->
    <uses-permission android:name="android.permission.ACCESS_FINE_LOCATION"/>
    <uses-permission android:name="android.permission.ACCESS_COARSE_LOCATION"/>
    <application
        android:label="Tweakd"
        android:name="${applicationName}"
        android:icon="@mipmap/ic_launcher">
        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:launchMode="singleTop"
            android:taskAffinity=""
            android:theme="@style/LaunchTheme"
            android:configChanges="orientation|keyboardHidden|keyboard|screenSize|smallestScreenSize|locale|layoutDirection|fontScale|screenLayout|density|uiMode"
            android:hardwareAccelerated="true"
            android:windowSoftInputMode="adjustResize">
            <!-- Specifies an Android theme to apply to this Activity as soon as
                 the Android process has started. This theme is visible to the user
                 while the Flutter UI initializes. After that, this theme continues
                 to determine the Window background behind the Flutter UI. -->
            <meta-data
              android:name="io.flutter.embedding.android.NormalTheme"
              android:resource="@style/NormalTheme"
              />

            <!-- Turn OFF Flutter's own deep linking. It defaults to ON when this
                 key is absent (FlutterActivityLaunchConfigs.deepLinkEnabled), and
                 when it is on the engine hands every incoming URL straight to
                 go_router as a route — including tweakd://c/{code} and the
                 tweakd://signup-callback / login-callback URLs Supabase's auth
                 flows depend on. None of those is a go_router location, so the
                 router lands on its "no routes for location" error page before
                 SplashPage ever mounts, which leaves the native launch screen up
                 forever (SplashPage is what calls FlutterNativeSplash.remove).
                 Share links are handled in Dart instead, by DeepLinkService, which
                 knows to ignore the auth callbacks and to wait for a session
                 before navigating. Keep this in step with FlutterDeepLinkingEnabled
                 in ios/Runner/Info.plist. -->
            <meta-data
              android:name="flutter_deeplinking_enabled"
              android:value="false"
              />
            <intent-filter>
                <action android:name="android.intent.action.MAIN"/>
                <category android:name="android.intent.category.LAUNCHER"/>
            </intent-filter>

            <!-- Supabase auth deep link: the "confirm your email" button in
                 the sign-up email redirects here, and supabase_flutter
                 exchanges the PKCE code in the URL for a session. Must match
                 the redirect URL allow-list in the Supabase dashboard. -->
            <intent-filter>
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.BROWSABLE" />
                <data android:scheme="tweakd" android:host="signup-callback" />
            </intent-filter>

            <!-- Car share links: https://web.tweakdapp.com/c/{code}, from a
                 scanned QR or a tapped link. The host is the web. subdomain,
                 not the apex: tweakdapp.com is the presentation site and
                 serves no share codes. It must stay equal to the backend's
                 sharing.public-base-url — a mismatch means every link opens
                 the browser instead of the app, silently.
                 autoVerify makes Android fetch
                 https://web.tweakdapp.com/.well-known/assetlinks.json at
                 install time; until that file is served and lists this app's
                 SHA-256 signing fingerprints, the link opens the browser and
                 the user gets a disambiguation dialog at best. The app_links
                 plugin delivers the intent to Dart (see DeepLinkService) —
                 Flutter's own deep linking is deliberately left off so the two
                 tweakd:// auth callbacks below keep going to Supabase alone. -->
            <intent-filter android:autoVerify="true">
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.BROWSABLE" />
                <data android:scheme="https" android:host="web.tweakdapp.com" android:pathPrefix="/c/" />
            </intent-filter>

            <!-- The custom-scheme fallback the website's "Open in app" button
                 uses. Universal Links / App Links deliberately don't fire for a
                 tap on a page already served from the same domain. -->
            <intent-filter>
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.BROWSABLE" />
                <data android:scheme="tweakd" android:host="c" />
            </intent-filter>

            <!-- Supabase auth deep link for the Android Sign in with Apple
                 flow. Apple has no Android SDK, so that sign-in runs in an
                 external browser and Supabase redirects back here when it
                 finishes. iOS needs no equivalent entry: it uses the native
                 Apple sheet and never opens this link. Must match the redirect
                 URL allow-list in the Supabase dashboard. -->
            <intent-filter>
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.BROWSABLE" />
                <data android:scheme="tweakd" android:host="login-callback" />
            </intent-filter>
        </activity>
        <!-- Defaults FCM applies to notifications the system draws itself,
             i.e. every message that arrives while the app is backgrounded or
             terminated. Without the channel id Android drops those onto an
             implicitly-created channel with default importance (no heads-up,
             no sound) that the user then has to fix by hand; without the icon
             it falls back to the launcher icon, which is opaque and renders as
             a white square. The channel id must match the one
             `LocalNotifications` creates, and the one the backend sets in
             `android.notification.channel_id`. -->
        <meta-data
            android:name="com.google.firebase.messaging.default_notification_channel_id"
            android:value="tweakd_default" />
        <meta-data
            android:name="com.google.firebase.messaging.default_notification_icon"
            android:resource="@drawable/ic_notification" />
        <meta-data
            android:name="com.google.firebase.messaging.default_notification_color"
            android:resource="@color/notification_accent" />

        <!-- Don't delete the meta-data below.
             This is used by the Flutter tool to generate GeneratedPluginRegistrant.java -->
        <meta-data
            android:name="flutterEmbedding"
            android:value="2" />
    </application>
    <!-- Required to query activities that can process text, see:
         https://developer.android.com/training/package-visibility and
         https://developer.android.com/reference/android/content/Intent#ACTION_PROCESS_TEXT.

         In particular, this is used by the Flutter engine in io.flutter.plugin.text.ProcessTextPlugin. -->
    <queries>
        <intent>
            <action android:name="android.intent.action.PROCESS_TEXT"/>
            <data android:mimeType="text/plain"/>
        </intent>

        <package android:name="com.google.android.apps.maps" />
        <package android:name="com.waze" />
    </queries>
</manifest>
